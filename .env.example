# Tandem Configuration
TANDEM_ENV=development
TANDEM_HOST=127.0.0.1
TANDEM_PORT=8000

# Simulator Ports
CORE_BANK_PORT=8001
CORE_BANK_2_PORT=8002
PROCESSOR_PORT=8003
DOCUMENTS_PORT=8004

# Database
TANDEM_DB_PATH=tandem_ledger.db

# Playwright & Replay
PLAYWRIGHT_HEADLESS=true

# Provider-backed discovery; deterministic replay needs no credential
DISCOVERY_PROVIDER=gemini
DISCOVERY_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
